# Doodle Theater server settings. All optional: set them as environment variables.
# AWS credentials come from the usual places (~/.aws/credentials, AWS_PROFILE, ...), never from here.

# AWS_REGION=us-east-1
# DT_PORT=8787
# DT_DATA=./data
# DT_PUBLIC_URL=http://192.168.1.20:8787      # what the phone opens; defaults to this laptop's Wi-Fi address

# Any Bedrock Converse model id or inference profile. "off" disables the feature (offline fallback).
# DT_VISION_MODEL=us.amazon.nova-2-lite-v1:0
# DT_STORY_MODEL=us.amazon.nova-2-lite-v1:0

# Defaults to the guardrail named "doodle-theater-kids" (create it with scripts/make_guardrail.py).
# DT_GUARDRAIL_ID=
# DT_GUARDRAIL_VERSION=DRAFT

# DT_NARRATOR_VOICE=Ruth
